{
  "name": "blarney-42",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev --port 3001",
    "build": "prisma generate && next build",
    "start": "next start --port 3001",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:seed:merch": "tsx prisma/seedMarketplace.ts",
    "prisma:seed:sample": "tsx prisma/sampleData.ts",
    "prisma:seed:all": "pnpm prisma:seed:sample && pnpm prisma:seed:merch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1166.0",
    "@aws-sdk/s3-request-presigner": "3.1166.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fflate": "0.8.3",
    "jose": "6.2.17",
    "lucide-react": "1.71.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.10",
    "eslint": "10.14.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": ">=10.34.9 <11"
  },
  "packageManager": "pnpm@10.34.9"
}
